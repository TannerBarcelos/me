---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import ReadPreview from '../components/ReadPreview.astro';
import siteConfig from '../data/site-config';
import { sortReadsReadingNow } from '../utils/data-utils';
import { DEFAULT_READ_SHELF } from '../data/read-shelves';
import { readsShelfPath } from '../utils/reads-links';

const projects = await getCollection('projects');

const reads = await getCollection('reads');
const readingNow = reads.filter(({ data }) => data.readingNow).sort(sortReadsReadingNow);
const readingNowShelves = [...new Set(readingNow.map((r) => r.data.shelf))];
const readingNowShelfOnly = readingNowShelves.length === 1 ? readingNowShelves[0] : undefined;
---

<BaseLayout description={siteConfig.description} showHeader={false}>
    <Hero />

    <div class="pb-24 sm:pb-32">
        <ProjectsShowcase projects={projects} />
    </div>

    {
        readingNow?.length > 0 && (
            <section class="pb-24 sm:pb-32">
                <div class="flex items-baseline justify-between mb-8">
                    <p class="font-mono text-xs text-muted select-none">
                        <span class="opacity-50">{'// '}</span>what I'm reading
                    </p>
                    <a
                        href={readsShelfPath(readingNowShelfOnly ?? DEFAULT_READ_SHELF)}
                        class="font-mono text-xs text-muted hover:text-main transition-colors duration-200 underline underline-offset-[5px] decoration-dashed decoration-accent/35 hover:decoration-solid hover:decoration-accent/65"
                    >
                        bookshelf →
                    </a>
                </div>

                <div>
                    {readingNow.map((read) => (
                        <ReadPreview read={read} headingLevel="h3" showTopicTags={false} hideMetaBadgesOnMobile />
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>
