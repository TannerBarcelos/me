[
    {
        "name": "Intro: who is Tanner",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "Who runs this site and what do they do?"
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_profile",
                "arguments": {}
            }
        ]
    },
    {
        "name": "Contact info routes to profile, not navigation",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "What's the best way to reach Tanner? Does he have a LinkedIn?"
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_profile",
                "arguments": {}
            }
        ]
    },
    {
        "name": "Career timeline",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "Where has Tanner worked before?"
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_experience",
                "arguments": {}
            }
        ]
    },
    {
        "name": "Single employer detail",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "What did he actually accomplish at Visa?"
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_experience",
                "arguments": {
                    "company": {
                        "$pattern": "^[Vv]isa$"
                    }
                }
            }
        ]
    },
    {
        "name": "Projects by technology",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "Has he built anything in Swift?"
            }
        ],
        "expectedCall": [
            {
                "functionName": "list_projects",
                "arguments": {
                    "technology": {
                        "$pattern": "^[Ss]wift$"
                    }
                }
            }
        ]
    },
    {
        "name": "Shipped side projects (status + ownership mapping)",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "Which of his personal projects have actually shipped?"
            }
        ],
        "expectedCall": [
            {
                "functionName": "list_projects",
                "arguments": {
                    "status": "live",
                    "ownership": "personal"
                }
            }
        ]
    },
    {
        "name": "AI projects map to the AI lane",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "What has he built in the AI and agents space?"
            }
        ],
        "expectedCall": [
            {
                "functionName": "list_projects",
                "arguments": {
                    "lane": "ai"
                }
            }
        ]
    },
    {
        "name": "Over-constrained query is relaxed, not retried blindly",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "Does he have any agent observability tools?"
            },
            {
                "role": "model",
                "type": "functioncall",
                "name": "list_projects",
                "arguments": {
                    "query": "agent observability tools"
                }
            },
            {
                "role": "user",
                "type": "functionresponse",
                "name": "list_projects",
                "response": {
                    "result": {
                        "projects": [
                            {
                                "slug": "relay",
                                "title": "Relay",
                                "status": "in-progress",
                                "lane": "apps",
                                "ownership": "personal",
                                "technologies": ["Swift", "SwiftUI", "AppKit"],
                                "summary": "A native macOS control plane for agentic software."
                            }
                        ],
                        "match": "partial",
                        "note": "No project matched every keyword; these match some of them.",
                        "page": 1,
                        "page_size": 5,
                        "total_count": 1,
                        "total_pages": 1,
                        "has_more": false
                    }
                }
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_project",
                "arguments": {
                    "project": {
                        "$pattern": "[Rr]elay"
                    }
                }
            }
        ]
    },
    {
        "name": "Named project deep dive",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "Tell me about RoamReady."
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_project",
                "arguments": {
                    "project": {
                        "$pattern": "[Rr]oam ?[Rr]eady"
                    }
                }
            }
        ]
    },
    {
        "name": "Coreference: list then drill into 'the podcast one'",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "What iOS apps has he made? Then tell me how the podcast one works."
            }
        ],
        "expectedCall": [
            {
                "functionName": "list_projects",
                "arguments": {
                    "$any": true
                },
                "mockOutput": {
                    "projects": [
                        {
                            "slug": "roamready",
                            "title": "RoamReady",
                            "status": "beta",
                            "lane": "apps",
                            "ownership": "personal",
                            "technologies": ["Swift", "SwiftUI"],
                            "summary": "A native camping trip planner for iPhone, iPad, and Mac."
                        },
                        {
                            "slug": "seeker",
                            "title": "Seeker",
                            "status": "in-progress",
                            "lane": "apps",
                            "ownership": "personal",
                            "technologies": ["Swift", "SwiftUI"],
                            "summary": "A native iOS podcast app with multiple independent queues plus semantic discovery."
                        }
                    ],
                    "page": 1,
                    "page_size": 5,
                    "total_count": 2,
                    "total_pages": 1,
                    "has_more": false
                }
            },
            {
                "functionName": "get_project",
                "arguments": {
                    "project": {
                        "$pattern": "[Ss]eeker"
                    }
                }
            }
        ]
    },
    {
        "name": "Read a named section after the overview",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "How is Relay architected under the hood?"
            },
            {
                "role": "model",
                "type": "functioncall",
                "name": "get_project",
                "arguments": {
                    "project": "Relay"
                }
            },
            {
                "role": "user",
                "type": "functionresponse",
                "name": "get_project",
                "response": {
                    "result": {
                        "title": "Relay",
                        "status": "in-progress",
                        "section": "Overview",
                        "text": "Relay is in early development. Coding agents keep getting more capable, but operating them is still fragmented...",
                        "sections": [
                            "Overview",
                            "The Agent Inbox",
                            "Product Principles",
                            "Native by Design",
                            "Roadmap",
                            "Non-Goals",
                            "Technology Stack",
                            "Outcome"
                        ]
                    }
                }
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_project",
                "arguments": {
                    "project": {
                        "$pattern": "[Rr]elay"
                    },
                    "section": {
                        "$pattern": "[Nn]ative [Bb]y [Dd]esign|[Tt]echnology [Ss]tack"
                    }
                }
            }
        ]
    },
    {
        "name": "Mid-chain recovery: unknown project falls back to experience",
        "messages": [
            {
                "role": "user",
                "type": "message",
                "content": "Tell me about the Nexus project."
            },
            {
                "role": "model",
                "type": "functioncall",
                "name": "get_project",
                "arguments": {
                    "project": "Nexus"
                }
            },
            {
                "role": "user",
                "type": "functionresponse",
                "name": "get_project",
                "response": {
                    "result": {
                        "error": "No project named \"Nexus\".",
                        "code": "NOT_FOUND",
                        "retryable": false,
                        "available": [
                            "RoamReady",
                            "RoleMark",
                            "AIOS Console",
                            "Relay",
                            "Compressor",
                            "ctx2pod",
                            "Kiln",
                            "Seeker",
                            "Spendaro",
                            "BI Secretary",
                            "CoinInsights",
                            "Coffee Connection"
                        ],
                        "suggestion": "Pick the closest title from available or call list_projects with a keyword. Employer products not listed here (e.g. at Visa) are covered by get_experience."
                    }
                }
            }
        ],
        "expectedCall": [
            {
                "functionName": "get_experience",
                "arguments": {
                    "$any": true
                }
            }
        ]
    },
